# SMAP 웹 환경변수 예시
#
# 실제 값은 .env.production 또는 .env.local 에 넣습니다(둘 다 git 추적 제외).
# 아래 값들은 정적 페이지 HTML에 빌드 시점에 박히므로
# 반드시 `npm run build` 실행 전에 설정해야 합니다.

# 정규 도메인. canonical·OG·sitemap·llms.txt의 절대 URL 기준이 됩니다.
NEXT_PUBLIC_SITE_URL=https://www.smap.site

# --- 검색엔진 웹마스터 도구 소유권 확인 ---
# 각 서비스에 사이트를 등록할 때 발급되는 코드를 넣습니다.
# 값이 없으면 해당 메타태그는 아예 출력되지 않습니다(빈 태그는 검증 실패를 만들기 때문).

# 구글 서치 콘솔 — https://search.google.com/search-console
# [HTML 태그] 방식 선택 시 content 값만 복사
GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 — https://searchadvisor.naver.com
# [사이트 소유확인] > HTML 태그 방식의 content 값만 복사
NAVER_SITE_VERIFICATION=

# 빙 웹마스터 도구 — https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# --- MCP ---
# /.well-known/mcp.json 에 광고할 원격 MCP 엔드포인트
MCP_HTTP_URL=https://mcp.aiagnt.kr/mcp
