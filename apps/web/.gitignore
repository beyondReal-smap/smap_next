# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어 있는 템플릿은 추적합니다. 새로 클론했을 때
# 어떤 환경변수가 필요한지 알 방법이 없으면 빌드 결과가 조용히 달라집니다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 데이터베이스 백업 파일
*.sql
*.dump
*.bak

# 의존성 디렉토리
/node_modules
/.pnp
.pnp.js

# 빌드 결과물
/.next/
/out/
/build/
/dist/

# 환경 변수 파일
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE 설정 파일
.idea/
