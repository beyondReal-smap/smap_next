# SMAP Backend Environment Variables
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# Database (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=smap2_db
MYSQL_CHARSET=utf8mb4

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=3600

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# SMS (Aligo)
ALIGO_USER_ID=
ALIGO_KEY=
ALIGO_SENDER=

# Firebase
FIREBASE_CREDENTIALS_PATH=backend/com-dmonster-smap-firebase-adminsdk-2zx5p-2610556cf5.json
FIREBASE_PROJECT_ID=com-dmonster-smap

# iOS Push
IOS_BUNDLE_ID=com.dmonster.smap
IOS_PUSH_RETRY_COUNT=3

# Email (SMTP)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_BCRYPT_COST=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# CORS / Frontend
FRONTEND_URL=https://nextstep.smap.site

# App
DEBUG=false
