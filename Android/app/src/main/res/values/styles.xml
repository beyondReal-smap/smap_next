<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmapWebView" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 필요에 따라 커스텀 속성 추가 -->
    </style>
    
    <!-- 스플래시 테마 (iOS 스타일 - 정적 화면) -->
    <style name="Theme.Smap.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <!-- 남색 스플래시 배경 위에서 시스템 아이콘이 흰색으로 보이게 한다. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- 페이드 인/아웃 애니메이션 비활성화 -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <!--
      MainActivity 전용 테마.
      링크로 MainActivity가 바로 열릴 때도 시스템 스플래시는 앱 아이콘 실행과 같은 색과 체크 핀을 쓴다.
      일반 창 배경은 Compose의 첫 화면과 이어지도록 유지한다.
    -->
    <style name="Theme.Smap.Main" parent="Theme.SmapWebView">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/splash_icon_small</item>
    </style>
</resources>
