<?xml version="1.0" encoding="utf-8"?>
<!--
  windowBackground.

  시스템 스플래시(Android 12+의 windowSplashScreenAnimatedIcon)가 끝나면
  SplashActivity, 이어서 MainActivity의 windowBackground가 짧게 노출된다.
  이 구간에 아이콘이 사라져 "빈 화면"이 보이는 부자연스러움을 막기 위해
  시스템 스플래시와 동일한 아이콘(splash_icon_small: inset 30%)을 layer로 둔다.

  splash_icon_small 자체가 inset으로 크기를 제어하므로 과거처럼 고해상도
  비트맵이 화면을 가득 채우는 현상은 발생하지 않는다.
  MainActivity는 Compose setContent 완료 시 Surface가 fillMaxSize로 덮어
  아이콘이 자연스럽게 가려진다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item android:drawable="@drawable/splash_icon_small" />
</layer-list>
